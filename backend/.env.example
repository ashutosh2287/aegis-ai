# Node Environment
NODE_ENV=development
PORT=4000

# Supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_MS=604800000

# Web URL for OAuth callbacks and reset password redirects
WEB_URL=http://localhost:3000

# Throttler
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Uploads
UPLOAD_DIR=uploads

# API
API_PREFIX=api

# Swagger
SWAGGER_ENABLED=true

# AI Configuration
# Provider: "openai", "gemini", or "ollama"
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.7

# AI Model Routing (per-endpoint models for performance optimization)
# For Ollama: chat uses high-quality model, structured endpoints use faster model
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_STRUCT_MODEL=qwen3:4b
# Optionally override per-endpoint:
# OLLAMA_WORKOUT_MODEL=qwen3:4b
# OLLAMA_NUTRITION_MODEL=qwen3:4b
# OLLAMA_ANALYSIS_MODEL=qwen3:4b